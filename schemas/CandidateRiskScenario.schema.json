{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CandidateRiskScenario",
  "description": "Experimental identification output; no assessment fields.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "bundle_id", "collection_batch", "observed_condition", "threat_event", "potential_consequence", "risk_statement", "business_context", "evidence_ids", "assumptions", "open_questions", "review_status", "origin"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "scenario_id": {"type": "string", "minLength": 1},
    "bundle_id": {"type": "string", "minLength": 1}, "collection_batch": {"type": "integer", "minimum": 1},
    "observed_condition": {"type": "string", "minLength": 1}, "threat_event": {"type": "string", "minLength": 1},
    "potential_consequence": {"type": "string", "minLength": 1}, "risk_statement": {"type": "string", "minLength": 1, "maxLength": 700},
    "business_context": {
      "type": "object", "additionalProperties": false,
      "required": ["objective_id", "objective", "service", "owner", "data_classification", "target_profile_outcomes", "origin"],
      "properties": {
        "objective_id": {"type": "string"}, "objective": {"type": "string"}, "service": {"type": "string"},
        "owner": {"type": "string"}, "data_classification": {"type": "string"},
        "target_profile_outcomes": {"type": "array", "items": {"type": "string"}}, "origin": {"type": "string"}
      }
    },
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "open_questions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "review_status": {"const": "candidate-human-review-required"}, "origin": {"const": "model-generated"}
  }
}
